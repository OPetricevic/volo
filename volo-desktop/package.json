{
    "name": "volo-desktop",
    "version": "0.1.0",
    "description": "Volo — Voice-first browser assistant desktop app",
    "main": "out/main/index.js",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "preview": "electron-vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "package": "electron-builder",
        "package:win": "electron-builder --win",
        "lint": "eslint src/"
    },
    "dependencies": {
        "zustand": "^5.0.5"
    },
    "devDependencies": {
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "@vitejs/plugin-react": "^4.4.1",
        "autoprefixer": "^10.4.21",
        "electron": "^33.4.0",
        "electron-builder": "^25.1.8",
        "electron-vite": "^3.1.0",
        "postcss": "^8.5.4",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.8.3",
        "vite": "^6.3.5",
        "vitest": "^4.1.8"
    },
    "build": {
        "appId": "com.volo.desktop",
        "productName": "Volo",
        "directories": {
            "output": "release"
        },
        "win": {
            "target": [
                "nsis",
                "portable"
            ],
            "icon": "assets/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "include": "installer/nsis-options.nsh"
        },
        "publish": {
            "provider": "github"
        }
    }
}